# Segredos deste perfil (copie para .env; o .env nunca vai para o Git).
# Valores aqui sobrescrevem o .env do tocador.

# Serviço de downloads (servicos/ytdlp desta fita)
# YTDLP_BASE_URL=http://127.0.0.1:8899
# Espera máxima de um download, em ms (playlists inteiras demoram; padrão 4 h)
# MIDIA_TIMEOUT_MS=14400000
# Teto de vídeos de uma playlist por pedido (0 = sem limite: a playlist inteira)
# MIDIA_MAX_ITENS=0
# Ajustes do próprio serviço (paralelismo e nivelamento): servicos/ytdlp/.env.example

# Chat web aberto a visitantes (vale só para esta fita; as explicações estão no .env.example do K7)
# WEB_PUBLIC=on
# WEB_HOST=0.0.0.0
# WEB_PUBLIC_LIMIT=20
# WEB_PUBLIC_LIMIT_TOTAL=200

# Só se o perfil usar o canal telegram: um bot próprio (@BotFather)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=
