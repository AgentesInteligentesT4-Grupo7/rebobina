# Ajustes do serviço de downloads (copie para .env nesta pasta; o .env nunca vai para o Git).
# O docker compose lê este .env ao subir: docker compose -f servicos/ytdlp/docker-compose.yml up -d --build

# Vídeos de uma playlist baixados ao mesmo tempo (1 a 6). Mais que isso, o YouTube passa a bloquear.
# YTDLP_PARALELO=3

# MP3/WAV saem já nivelados do download. 0 desliga (o áudio sai como veio do YouTube).
# NIVELAR_AO_BAIXAR=1

# Volume alvo do nivelamento, em LUFS (-14 é o padrão das plataformas de música).
# NIVELAR_LUFS=-14

# Músicas niveladas ao mesmo tempo. Vazio = automático (núcleos da máquina menos 2); um número força.
# NIVELAR_PARALELO=
